{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frame (dev server)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8080"],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "jinja": false,
      "justMyCode": true
    },
    {
      "name": "Make test library",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/make_test_library.py",
      "cwd": "${workspaceFolder}"
    }
  ]
}
