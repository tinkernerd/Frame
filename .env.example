# Copy this file to .env and adjust.
# Local (VS Code) testing — paths relative to the project folder:
MOVIES_DIR=./test-library/movies
SHOWS_DIR=./test-library/shows
CONFIG_DIR=./config

# Optional: free key from https://www.themoviedb.org/settings/api
# Either the "API Key" or the longer "API Read Access Token" works.
TMDB_API_KEY=

# Optional: your ThePosterDB username. Poster downloads are credited to you
# (it's the performed_by=... part of ThePosterDB download links).
TPDB_USERNAME=
