# Server settings for docker compose. Copy to .env next to docker-compose.yml.

# Where the NAS shares are mounted on the server
MOVIES_PATH=/mnt/nas/movies
SHOWS_PATH=/mnt/nas/shows

# User/group that owns the media files (run `id` on the server, or `ls -n` on the share)
PUID=1000
PGID=1000

# Port to open Frame on: http://<server-ip>:8080
PORT=8080

TMDB_API_KEY=
TPDB_USERNAME=

# Image version: latest (newest release), a specific release like v0.01, or edge (newest main)
FRAME_TAG=latest
